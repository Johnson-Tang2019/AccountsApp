{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accounts recognition rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "AccountsRecognitionRules" },
    "version": { "type": "integer", "const": 1 },
    "rules": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "literal": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001F\\u007F-\\u009F]).*\\S$" },
    "terms": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/literal" } },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "channel", "packageName", "action"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$" },
        "enabled": { "type": "boolean", "default": true },
        "channel": { "enum": ["screen", "notification"] },
        "packageName": { "type": "string", "maxLength": 160, "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$" },
        "action": { "enum": ["accept", "reject"] },
        "containsAll": { "$ref": "#/$defs/terms" },
        "containsAny": { "$ref": "#/$defs/terms" },
        "containsNone": { "$ref": "#/$defs/terms" },
        "completionPhrase": { "$ref": "#/$defs/literal", "minLength": 3 },
        "amountAnchor": { "$ref": "#/$defs/literal" },
        "merchant": { "$ref": "#/$defs/literal" }
      },
      "if": { "properties": { "action": { "const": "accept" } }, "required": ["action"] },
      "then": { "required": ["completionPhrase"] },
      "else": {
        "properties": { "completionPhrase": false, "amountAnchor": false, "merchant": false },
        "anyOf": [
          { "properties": { "containsAll": { "minItems": 1 } }, "required": ["containsAll"] },
          { "properties": { "containsAny": { "minItems": 1 } }, "required": ["containsAny"] }
        ]
      }
    }
  }
}
